# ---------------------------------------------------------------------------
# Family CFO configuration
# Copy to .env and fill in. NEVER commit .env or real credentials.
# ---------------------------------------------------------------------------

# Local ledger location. Relative paths resolve against the project root.
FAMILY_CFO_DATA_DIR=./data
FAMILY_CFO_DB_PATH=./data/family_cfo.db
FAMILY_CFO_HOUSEHOLD=我家
FAMILY_CFO_CURRENCY=CNY

# --- Feishu / Lark open platform -------------------------------------------
# Create an internal (custom) app: https://open.feishu.cn/app
# Grant scopes: bitable:app (read/write) or bitable:app:readonly for pull-only.
# Add the app as a collaborator of the Bitable, otherwise every call fails.
FAMILY_CFO_FEISHU_APP_ID=
FAMILY_CFO_FEISHU_APP_SECRET=
FAMILY_CFO_FEISHU_BASE_URL=https://open.feishu.cn
# app_token of the Bitable (from the URL https://xxx.feishu.cn/base/<app_token>)
FAMILY_CFO_FEISHU_APP_TOKEN=
# Optional: override table ids; otherwise resolved/created by name from config/feishu_tables.yaml
FAMILY_CFO_FEISHU_TABLE_PREFIX=FamilyCFO_

# --- Behaviour -------------------------------------------------------------
FAMILY_CFO_TIMEZONE=Asia/Shanghai
# Transactions at or above this amount without a confident category go to review.
FAMILY_CFO_REVIEW_THRESHOLD=200
# Cross-platform duplicate candidate window (days, one-sided).
FAMILY_CFO_DEDUPE_WINDOW_DAYS=2
# Transfer matching window (days, one-sided).
FAMILY_CFO_TRANSFER_WINDOW_DAYS=3
# Automatically back up before destructive operations.
FAMILY_CFO_AUTO_BACKUP=true
